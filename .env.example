# Copy to .env and fill in. Never commit .env.
MISTRAL_API_KEY=your-mistral-api-key
# Optional: only needed for Hinglish transcription
SARVAM_API_KEY=your-sarvam-api-key
# Optional
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v2.5
MAX_UPLOAD_MB=500
# Optional: Mistral chat model (default mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# Optional limits for a public deployment (0 or unset = no limit; YouTube on by default)
JOBS_PER_DAY=0
JOBS_PER_IP_PER_HOUR=0
QUESTIONS_PER_JOB=0
MAX_AUDIO_MINUTES=0
ALLOW_YOUTUBE=1
